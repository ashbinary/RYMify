{
  "manifest_version": 3,
  "name": "RYMify",
  "version": "1.0.0",
  "description": "Replace AOTY's numeric rating with a 5-star rating system based on RateYourMusic.",
  "permissions": [],
  "content_scripts": [
    {
      "matches": ["https://www.albumoftheyear.org/*"],
      "js": ["rymify.js"],
      "css": ["rymify.css"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
   "16": "icon/16.png",
   "32": "icon/32.png",
   "48": "icon/48.png",
   "128": "icon/128.png"
  }
}
